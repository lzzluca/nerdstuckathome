---
interface Props {
  tags: string[];
  activeTag?: string;
}
const { tags, activeTag } = Astro.props;
---
<aside class="sidebar">
  <div class="card profile">
    <div class="avatar">L</div>
    <h3>Hey, I'm Luca</h3>
    <p>Senior software engineer moving into AI engineering. I write about self-hosting, LLM tooling and the occasional frontend deep-dive.</p>
    <div class="socials">
      <a href="https://github.com/lzzluca" target="_blank" rel="noopener" aria-label="GitHub" class="icon-btn">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .5z"/></svg>
      </a>
      <a href="/rss.xml" aria-label="RSS feed" class="icon-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
      </a>
    </div>
  </div>

  <div class="tag-cloud">
    <h3>Browse by tag</h3>
    <div class="pills">
      {tags.map((tag) => (
        <a href={`/tags/${tag}`} class={`pill ${tag === activeTag ? 'pill-active' : ''}`}>{tag}</a>
      ))}
    </div>
  </div>

  <div class="card badge">
    <div class="badge-title">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#3f5a37" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
      Static · no database
    </div>
    <p>Built with Astro and deployed straight from a git push — nothing to patch, nothing to get hacked.</p>
  </div>
</aside>

<style>
  .sidebar { display: flex; flex-direction: column; gap: 28px; }
  .card {
    padding: 24px;
    border-radius: 16px;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .avatar {
    width: 52px; height: 52px; border-radius: 14px;
    background: var(--ink);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Fraunces', Georgia, serif;
    color: var(--bg);
    font-size: 20px;
    font-weight: 700;
  }
  .profile h3 { font-size: 16px; }
  .profile p { margin: 0; font-size: 14px; line-height: 1.6; color: var(--ink-muted); }
  .socials { display: flex; gap: 10px; margin-top: 4px; }
  .icon-btn {
    width: 34px; height: 34px; border-radius: 8px;
    background: var(--pill-bg);
    display: flex; align-items: center; justify-content: center;
    color: var(--ink);
  }
  .icon-btn:hover { text-decoration: none; background: var(--border); }

  .tag-cloud { display: flex; flex-direction: column; gap: 12px; }
  .tag-cloud h3 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    font-family: inherit;
  }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill {
    font-size: 13px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--pill-bg);
    color: var(--ink-muted);
  }
  .pill:hover { text-decoration: none; background: var(--border); }
  .pill-active { background: var(--ink); color: var(--bg); }

  .badge { background: var(--badge-bg); border-color: var(--badge-border); gap: 8px; }
  .badge-title {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 700; color: var(--badge-ink);
  }
  .badge p { margin: 0; font-size: 13px; line-height: 1.5; color: var(--ink-muted); }
</style>
